OpenAI_API_Key="xxx"
Base_URL="https://atlas.protiviti.com/xxx"
Model="gpt-5-6-luna-latest-gs"
API_Version="2025-04-01-preview"
Auth_headers = "Experimentyyyymmdd-Subscription-Key"

# LLM provider selection (provider-agnostic layer)
# Set `LLM_PROVIDER` to one of: azure, openai, ollama, groq, together, lmstudio
# Example: use Azure OpenAI (default for existing deployments)
LLM_PROVIDER=azure
# API key and base URL (aliases to preserve backward compatibility)
LLM_API_KEY="xxx"
LLM_BASE_URL="https://atlas.protiviti.com/xxx"
LLM_API_VERSION="2025-04-01-preview"
# Low-latency default for interactive product-page actions. Replace with another
# enabled deployment name when higher reasoning depth is preferred.
LLM_MODEL="gpt-5-6-luna-latest-gs"
# Optional: when using Azure API Management gateway, set the header name
LLM_AUTH_HEADER_NAME=Experimentyyyymmdd-Subscription-Key

# Atlas gateway (https://atlas.protiviti.com) requires Entra ID sign-in in
# addition to the subscription key; a key alone is rejected with 403.
# When the three ATLAS_* values below are set, the app signs in through the
# browser (azure-identity InteractiveBrowserCredential) and sends the bearer
# token together with the subscription-key header.
# Prime the sign-in once with:  python -m derivapro.llm.atlas_auth
ATLAS_TENANT_ID=
ATLAS_CLIENT_ID=
ATLAS_TOKEN_SCOPE=api://<atlas-app-id>/.default
# The following are optional; they fall back to LLM_BASE_URL / LLM_API_VERSION /
# LLM_AUTH_HEADER_NAME / LLM_API_KEY when left blank.
ATLAS_ENDPOINT=
ATLAS_API_VERSION=
ATLAS_SUBSCRIPTION_HEADER=
ATLAS_SUBSCRIPTION_KEY=
ATLAS_AUTH_TYPE_HEADER=AtlasAuthType
ATLAS_AUTH_TYPE_VALUE=EntraID
# Keep the token cache on disk so Flask reloads do not force a new sign-in
ATLAS_TOKEN_CACHE_PERSIST=1

FRED_API_Key="xxx"

SECRET_KEY=replace_with_a_secure_random_value_for_local_development
FLASK_ENV=development
FLASK_DEBUG=true
LOG_LEVEL=INFO

DATABASE_URL=sqlite:///derivapro.db
# Or use postgresql DATABASE_URL=postgresql://...........

REDIS_URL=
