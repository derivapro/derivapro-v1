OpenAI_API_Key="xxx"
Base_URL="https://atlas.protiviti.com/xxx"
Model="gpt-5-4-20260305-gs"
API_Version="2025-04-01-preview"
Auth_headers = "Experimentyyyymmdd-Subscription-Key"

# LLM provider selection (provider-agnostic layer)
# Set `LLM_PROVIDER` to one of: azure, openai, ollama, groq, together, lmstudio
# Example: use Azure OpenAI (default for existing deployments)
LLM_PROVIDER=azure
# API key and base URL (aliases to preserve backward compatibility)
LLM_API_KEY="xxx"
LLM_BASE_URL="https://atlas.protiviti.com/xxx"
LLM_API_VERSION="2025-04-01-preview"
LLM_MODEL="gpt-5-4-20260305-gs"
# Optional: when using Azure API Management gateway, set the header name
LLM_AUTH_HEADER_NAME=Experimentyyyymmdd-Subscription-Key

FRED_API_Key="xxx"

SECRET_KEY=replace_with_a_secure_random_value_for_local_development
FLASK_ENV=development
FLASK_DEBUG=true
LOG_LEVEL=INFO

DATABASE_URL=sqlite:///derivapro.db
# Or use postgresql DATABASE_URL=postgresql://...........
